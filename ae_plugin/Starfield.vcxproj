<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{CF7F8DB5-87E1-4D7F-9B80-16BCDB0AF95E}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>StarfieldParticle</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <STARFIELD_AE_SDK_ROOT Condition="'$(STARFIELD_AE_SDK_ROOT)' == ''">$(MSBuildProjectDirectory)\..\AdobeSDK\May2023_AfterEffectsSDK</STARFIELD_AE_SDK_ROOT>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType><UseDebugLibraries>true</UseDebugLibraries><PlatformToolset>v145</PlatformToolset><CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType><UseDebugLibraries>false</UseDebugLibraries><PlatformToolset>v145</PlatformToolset><WholeProgramOptimization>true</WholeProgramOptimization><CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\artifacts\plugin\2023\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\artifacts\plugin\2023\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>StarfieldParticle</TargetName><TargetExt>.aex</TargetExt>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel><TreatWarningAsError>false</TreatWarningAsError><SDLCheck>true</SDLCheck>
      <!-- _CRT_SECURE_NO_WARNINGS: the May 2023 SDK's Param_Utils.h still uses strncpy,
           which /sdl (SDLCheck) escalates to an error. Owned code does not use it. -->
      <PreprocessorDefinitions>MSWindows;WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\include;$(STARFIELD_AE_SDK_ROOT)\Examples\Headers;$(STARFIELD_AE_SDK_ROOT)\Examples\Headers\SP;$(STARFIELD_AE_SDK_ROOT)\Examples\Headers\Win;$(STARFIELD_AE_SDK_ROOT)\Examples\Resources;$(STARFIELD_AE_SDK_ROOT)\Examples\Util;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard><ConformanceMode>true</ConformanceMode><ExceptionHandling>Sync</ExceptionHandling>
      <!-- AE 2023 ships an older app-local MSVCP140.dll. Keep modern STL/CRT
           implementation private to this AEX; the Core boundary is a C ABI. -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <ResourceCompile><PreprocessorDefinitions>MSWindows;%(PreprocessorDefinitions)</PreprocessorDefinitions></ResourceCompile>
    <Link><SubSystem>Windows</SubSystem><GenerateDebugInformation>true</GenerateDebugInformation><ImportLibrary>$(IntDir)StarfieldParticle.lib</ImportLibrary><TargetMachine>MachineX64</TargetMachine></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Diagnostics.cpp" />
    <ClCompile Include="CoreLoader.cpp" />
    <ClCompile Include="EffectMain.cpp" />
      <ClCompile Include="GraphCarrier.cpp" />
    <ClCompile Include="NativeNodeGraph.cpp" />
    <ClCompile Include="GraphParameter.cpp" />
    <ClCompile Include="Parameters.cpp" />
    <ClCompile Include="SmartRender.cpp" />
    <ClCompile Include="WorldBridge.cpp" />
    <ClCompile Include="..\src\core\Geometry.cpp" />
    <ClCompile Include="..\src\core\Graph.cpp" />
    <ClCompile Include="..\src\core\GraphConstruction.cpp" />
    <ClCompile Include="..\src\core\Render.cpp" />
    <ClCompile Include="..\src\core\SequenceCodec.cpp" />
    <ClCompile Include="..\src\core\Settings.cpp" />
    <ClCompile Include="..\src\core\Time.cpp" />
    <!-- Outputs is required: without it MSBuild skips the custom build (MSB8018). The
         incremental check only looks at the .r file unless the headers it includes are
         declared through AdditionalInputs, which is exactly how a stale PiPL used to
         reach the .aex and made AE reject it with "global outflags mismatch". BuildPiPL.ps1
         additionally verifies the generated resource against the header values. -->
    <CustomBuild Include="StarfieldPiPL.r">
      <Message>Generating AE PiPL resource</Message>
      <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\BuildPiPL.ps1" -SdkRoot "$(STARFIELD_AE_SDK_ROOT)" -IntermediateDir "$(IntDir)." -ResourceSource "$(MSBuildProjectDirectory)\StarfieldPiPL.r"</Command>
      <Outputs>$(IntDir)StarfieldPiPL.rr;$(IntDir)StarfieldPiPL.rrc;$(IntDir)StarfieldPiPL.rc</Outputs>
      <AdditionalInputs>$(MSBuildProjectDirectory)\PluginFlags.h;$(MSBuildProjectDirectory)\PluginVersion.h</AdditionalInputs>
    </CustomBuild>
    <ResourceCompile Include="$(IntDir)StarfieldPiPL.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
