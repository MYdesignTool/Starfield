<?xml version="1.0" encoding="UTF-8"?>
<!-- Starfield node editor panel. Targets After Effects 2023 on Windows x64, the only
     current host target. The panel speaks the versioned JSON protocol of ADR 0009
     through a namespaced ExtendScript gateway; it never touches the effect's
     arbitrary-data graph parameter directly. -->
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="org.starfieldfx.panel"
                   ExtensionBundleVersion="0.1.0.0"
                   ExtensionBundleName="Starfield Node Editor"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="org.starfieldfx.panel.main" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT = After Effects. 23.0 and newer; the exact tested build is recorded
           in docs/compatibility-matrix.md. -->
      <Host Name="AEFT" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="org.starfieldfx.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/starfield_gateway.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Starfield Node Editor</Menu>
          <Geometry>
            <Size>
              <Height>660</Height>
              <Width>400</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
