<?xml version="1.0" encoding="UTF-8"?>
<!-- Starfield Particle Controls panel. Targets After Effects 2023 on Windows x64, the only
     current host target. The panel speaks the versioned JSON protocol of ADR 0009
     through a namespaced ExtendScript gateway; it never touches the effect's
     arbitrary-data graph parameter directly. -->
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="org.starfieldfx.panel"
                   ExtensionBundleVersion="0.1.0.56"
                   ExtensionBundleName="Starfield Particle Controls"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="org.starfieldfx.panel.main" Version="0.1.56" />
    <Extension Id="org.starfieldfx.panel.presets" Version="0.1.56" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT = After Effects. 23.0 and newer; the exact tested build is recorded
           in docs/compatibility-matrix.md. -->
      <Host Name="AEFT" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="org.starfieldfx.panel.presets">
      <DispatchInfo>
        <Resources><MainPath>./presets.html</MainPath><ScriptPath>./jsx/starfield_gateway.jsx</ScriptPath></Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI><Type>Modeless</Type><Menu>Starfield Presets</Menu>
          <Geometry><Size><Height>700</Height><Width>1040</Width></Size><MinSize><Height>450</Height><Width>480</Width></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="org.starfieldfx.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/starfield_gateway.jsx</ScriptPath>
          <!-- No CEFCommandLine block on purpose. CEP appends those switches to the SHARED
               CEF command line of the host, so an extension can change how every other CEP
               panel in the same host starts up. The panel does not need file-access
               switches, and a host-wide side effect is not worth the convenience. -->
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Starfield Particle Controls</Menu>
          <Geometry>
            <Size>
              <Height>660</Height>
              <Width>400</Width>
            </Size>
            <MinSize>
              <Height>420</Height>
              <Width>320</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
