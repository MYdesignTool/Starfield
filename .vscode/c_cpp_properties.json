{
  "env": {
    "starfieldCompiler": "C:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools/VC/Tools/MSVC/14.51.36231/bin/Hostx64/x64/cl.exe",
    "starfieldIncludes": [
      "${workspaceFolder}/include",
      "${workspaceFolder}/ae_plugin",
      "${workspaceFolder}/AdobeSDK/May2023_AfterEffectsSDK/Examples/Headers",
      "${workspaceFolder}/AdobeSDK/May2023_AfterEffectsSDK/Examples/Headers/SP",
      "${workspaceFolder}/AdobeSDK/May2023_AfterEffectsSDK/Examples/Util",
      "${workspaceFolder}/artifacts/webview2/dependencies/sdk-1.0.4258.31/build/native/include"
    ],
    "starfieldDefines": ["MSWindows", "WIN32", "_WINDOWS", "_CRT_SECURE_NO_WARNINGS"]
  },
  "configurations": [
    {
      "name": "Win32",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "defines": ["${starfieldDefines}", "STARFIELD_NODE_KIND_EMITTER"],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "browse": {
        "path": ["${workspaceFolder}/include", "${workspaceFolder}/ae_plugin", "${workspaceFolder}/src", "${workspaceFolder}/tests"],
        "limitSymbolsToIncludedHeaders": true,
        "databaseFilename": "${workspaceFolder}/artifacts/editor/browse.vc.db"
      }
    },
    {
      "name": "Particle",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "defines": ["${starfieldDefines}", "STARFIELD_NODE_KIND_PARTICLE"],
      "cStandard": "c17",
      "cppStandard": "c++20"
    },
    {
      "name": "Transform",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "defines": ["${starfieldDefines}", "STARFIELD_NODE_KIND_TRANSFORM"],
      "cStandard": "c17",
      "cppStandard": "c++20"
    },
    {
      "name": "Force",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "defines": ["${starfieldDefines}", "STARFIELD_NODE_KIND_FORCE"],
      "cStandard": "c17",
      "cppStandard": "c++20"
    },
    {
      "name": "WebView2 Host",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "defines": ["${starfieldDefines}", "STARFIELD_WITH_WEBVIEW2", "UNICODE", "_UNICODE"],
      "cStandard": "c17",
      "cppStandard": "c++20"
    },
    {
      "name": "OpenCL Kernel",
      "compilerPath": "${starfieldCompiler}",
      "intelliSenseMode": "windows-msvc-x64",
      "includePath": ["${starfieldIncludes}"],
      "forcedInclude": ["${workspaceFolder}/.vscode/OpenClIntelliSense.h"],
      "cStandard": "c17",
      "cppStandard": "c++20"
    }
  ],
  "version": 4,
  "enableConfigurationSquiggles": true
}
